# --- Con docker compose (hostnames internos de la red mired) ---
# PERSISTENCE_SERVICE_URL=http://persistence-service:8000
# VALIDATION_SERVICE_URL=http://validation-service:8000
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# REDIS_URL=redis://redis:6379

# --- Con uvicorn local ---
# Requiere un override de infra que publique 8001/8003/9092/6379 en el host.
PERSISTENCE_SERVICE_URL=http://localhost:8003
VALIDATION_SERVICE_URL=http://localhost:8001
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0

PORT=8000
PERSISTENCE_FAILURE_THRESHOLD=5
PERSISTENCE_RECOVERY_TIMEOUT_SECONDS=30
PERSISTENCE_CALL_TIMEOUT_SECONDS=120
VALIDATION_CALL_TIMEOUT_SECONDS=10
EXTRACTION_CACHE_TTL_SECONDS=3600
EXTRACTION_CACHE_ENABLED=true
